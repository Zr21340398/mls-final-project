{
  "seed": 7,
  "data": "data/processed/smoke",
  "model": {
    "kind": "gru",
    "hidden": 16
  },
  "train": {
    "method": "federated",
    "device": "cpu",
    "threads": 2,
    "rounds": 3,
    "local_steps": 2,
    "batch_size": 16,
    "lr": 0.001,
    "clients_per_round": 4,
    "scheduler": "coverage",
    "weighting": "equal",
    "eval_every": 1
  },
  "simulation": {
    "availability": 1.0,
    "dropout": 0.1,
    "min_survivors": 2,
    "deadline_s": 60.0,
    "reference_step_s": 0.05,
    "calibration_source": "assumed_smoke_only",
    "coverage_fraction": 0.25,
    "aggregation": "plain",
    "profiles": [
      {
        "name": "constrained",
        "speed": 0.25,
        "ram_mb": 128,
        "mbps": 0.5,
        "latency_ms": 100,
        "energy_budget": 1000.0,
        "inference_deadline_ms": 100
      },
      {
        "name": "intermediate",
        "speed": 0.5,
        "ram_mb": 512,
        "mbps": 5,
        "latency_ms": 50,
        "energy_budget": 1000.0,
        "inference_deadline_ms": 50
      },
      {
        "name": "capable",
        "speed": 1.0,
        "ram_mb": 2048,
        "mbps": 20,
        "latency_ms": 10,
        "energy_budget": 1000.0,
        "inference_deadline_ms": 20
      }
    ]
  },
  "privacy": {
    "enabled": false,
    "clip_norm": 1.0,
    "noise_multiplier": 8.0,
    "delta": 1e-05,
    "epsilon_cap": 8.0,
    "deterministic_noise": false,
    "clip_updates": true
  }
}